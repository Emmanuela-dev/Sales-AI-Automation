{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    // Consumers import the .ts sources directly (see "main" in package.json),
    // so this package is type-checked rather than compiled to dist.
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
